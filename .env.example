# ============================================
#   MCAP 环境配置文件
# ============================================
# 复制此文件为 .env 并根据实际环境修改参数
# .env 文件不应提交到版本控制中

# ---------- 应用 ----------
# 对外公开的服务地址（用于生成绑定链接等）
APP_URL=http://localhost:6227

# 服务监听端口
PORT=6227

# ---------- 数据库 ----------
# SQLite 数据库文件路径（相对于项目根目录）
DB_PATH=mcap.db

# ---------- JWT ----------
# JWT 签名密钥（生产环境请务必更换为强随机字符串）
JWT_SECRET=mcap-jwt-secret-key
